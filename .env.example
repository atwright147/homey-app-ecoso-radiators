# Tuya IoT cloud credentials.
#
# Used by `npm run get-keys` (get-keys.py) to fetch each heater's local key from
# the Tuya cloud API.
#
# Copy this file and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is gitignored and is NEVER committed. The real values are kept in the
# owner's password manager — restore them from there if this file is lost.
#
# Do NOT put comments at the end of a value line: get-keys.py takes everything
# after "=" literally (it only trims surrounding whitespace).

# Tuya IoT Access ID / Client ID
TUYA_API_KEY=

# Tuya IoT Access Secret / Client Secret
TUYA_API_SECRET=

# Data centre region: cn | us | eu | in   (eu for Norway)
TUYA_REGION=eu

# Tuya / Smart Life account UID (optional)
TUYA_APP_UID=

# Optional: only fetch keys for these device IDs (space-separated)
# TARGET_IDS=
