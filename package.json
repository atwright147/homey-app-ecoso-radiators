{
  "name": "com.ecoso.rads",
  "version": "1.0.0",
  "description": "Control ECOSO electric panel heaters via Tuya local LAN",
  "main": "app.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "validate": "homey app validate --level publish",
    "homey:install": "homey app install",
    "dev": "homey app run",
    "cli": "tsx src/index.ts",
    "cli:state": "tsx src/index.ts --device 1 state",
    "cli:state2": "tsx src/index.ts --device 2 state",
    "scan": ".venv/bin/python3 -m tinytuya scan",
    "get-keys": ".venv/bin/python3 get-keys.py",
    "postinstall": "patch-package"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "tuyapi": "^7.7.1"
  },
  "devDependencies": {
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^25.5.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
